# Configuración Apache / cPanel / Hostinger para URLs limpias y SEO
RewriteEngine On
RewriteBase /

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Si la ruta solicitada es /gas-lp-a-domicilio-en-metepec/ o /gas-lp-a-domicilio-en-toluca/, servir index.html
RewriteRule ^gas-lp-a-domicilio-en-metepec/?$ index.html [L,QSA]
RewriteRule ^gas-lp-a-domicilio-en-toluca/?$ index.html [L,QSA]

# Para cualquier otra ruta que no sea un archivo físico existente, servir index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L,QSA]
